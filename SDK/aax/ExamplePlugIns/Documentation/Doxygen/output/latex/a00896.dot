  Node8 [label="Hybrid Processing architecture",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$a00902.html",tooltip="An architecture combining low-latency and high-latency audio processing."];
  Node10 [label="MIDI",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$a00904.html",tooltip="How to route and process MIDI in AAX plug-ins."];
  Node11 [label="Offline processing\l interface",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$a00905.html",tooltip="Advanced offline processing features."];
